{
  "Application": {
    "PortableMode": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Synchronization": {
    "IntervalMinutes": 60,
    "RunOnStartup": true,
    "OfflineFirst": true
  }
}