     <StackPanel><TextBlock Text="Settings" FontSize="30" FontWeight="Bold"/><TextBlock Text="Application behavior, AI providers, safety, performance, and job reliability." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,22"/></StackPanel>
     <TabControl Grid.Row="1">
      <TabItem Header="Appearance"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Width="900" HorizontalAlignment="Left" Margin="16"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Application color and typography" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Choose an accent pair and a separate system-wide font palette. Contrast protection remains active across every screen, grid, editor, menu, tooltip, and dialog." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,18"/><TextBlock Text="Font color palette" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentFontPaletteName, StringFormat=Current: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,10"/><WrapPanel><Button Content="Adaptive Contrast" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyFontPaletteCommand}" CommandParameter="Adaptive Contrast" Margin="0,0,8,8"/><Button Content="Cool Slate" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyFontPaletteCommand}" CommandParameter="Cool Slate" Margin="0,0,8,8"/><Button Content="Warm Graphite" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyFontPaletteCommand}" CommandParameter="Warm Graphite" Margin="0,0,8,8"/><Button Content="Azure Ink" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyFontPaletteCommand}" CommandParameter="Azure Ink" Margin="0,0,8,8"/><Button Content="Emerald Ink" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyFontPaletteCommand}" CommandParameter="Emerald Ink" Margin="0,0,8,8"/><Button Content="Violet Ink" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyFontPaletteCommand}" CommandParameter="Violet Ink" Margin="0,0,8,8"/><Button Content="High Contrast" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyFontPaletteCommand}" CommandParameter="High Contrast" Margin="0,0,8,8"/></WrapPanel><Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Live preview" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Primary text — headings, values, grid content, and editor labels" Margin="0,10,0,0"/><TextBlock Text="Secondary text — descriptions, helper text, timestamps, and status details" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/><TextBlock Text="Disabled text — unavailable actions remain readable without looking active" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,6,0,0"/><Border Background="{DynamicResource HeaderSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,12,0,0"><TextBlock Text="Grid and section header preview" Foreground="{DynamicResource HeaderTextBrush}" FontWeight="Bold"/></Border></StackPanel></Border></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Synchronization"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Width="760" HorizontalAlignment="Left" Margin="16"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Synchronization" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Interval in minutes (5–1440)" Margin="0,18,0,6"/><TextBox Text="{Binding Settings.IntervalMinutes, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Run a background synchronization shortly after startup" IsChecked="{Binding Settings.RunOnStartup}" Margin="0,18,0,8"/><CheckBox Content="Offline-first: always display SQLite data before network refresh" IsChecked="{Binding Settings.OfflineFirst}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="AI Providers"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Width="900" HorizontalAlignment="Left" Margin="16"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="AI recommendation providers" FontSize="20" FontWeight="SemiBold"/><CheckBox Content="Enable AI recommendations" IsChecked="{Binding Settings.EnableAiRecommendations}" Margin="0,14,0,0"/><CheckBox Content="Automatic provider fallback" IsChecked="{Binding Settings.AutomaticAiFallback}" Margin="0,10,0,14"/><Button Content="Open Puter in Chrome" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Settings.OpenPuterAuthenticationCommand}" HorizontalAlignment="Left"/><ItemsControl ItemsSource="{Binding Settings.AiProviders}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="70"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding Provider}" FontWeight="Bold"/><CheckBox Grid.Column="1" Content="Use" IsChecked="{Binding Enabled}"/><TextBox Grid.Column="2" Text="{Binding Priority}" Margin="5,0"/><TextBox Grid.Column="3" Text="{Binding Model}" Margin="5,0"/><Button Grid.Column="4" Content="Test connection" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.Settings.TestProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><PasswordBox Grid.Row="1" Grid.ColumnSpan="4" Margin="0,10,0,0" PasswordChanged="AiProviderApiKeyBox_OnPasswordChanged"/><TextBlock Grid.Row="2" Grid.ColumnSpan="5" Text="{Binding Status}" Foreground="{DynamicResource GoldOnLightBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="AI Automation"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Width="820" HorizontalAlignment="Left" Margin="16"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="AI decisions and execution evidence" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Every diagnosis and recommendation is routed through the configured AI provider chain. The policy below controls approval, rejection, direct low-risk execution, and before/after evidence for the active site." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/><CheckBox Content="Generate an AI diagnosis for every application error" IsChecked="{Binding Settings.EnableAiErrorDiagnosis}"/><TextBlock Text="Error decision policy" Margin="0,14,0,6"/><ComboBox SelectedValue="{Binding Settings.ErrorDecisionMode}" SelectedValuePath="Tag"><ComboBoxItem Content="Ask the user" Tag="Ask"/><ComboBoxItem Content="Auto-approve low-risk actions" Tag="AutoLowRisk"/><ComboBoxItem Content="Manual decisions only" Tag="ManualOnly"/></ComboBox><CheckBox Content="Execute verified low-risk AI actions automatically" IsChecked="{Binding Settings.AutoExecuteLowRiskAiActions}" Margin="0,14,0,0"/><CheckBox Content="Automatically reject high-risk AI actions" IsChecked="{Binding Settings.AutoRejectHighRiskAiActions}" Margin="0,10,0,0"/><CheckBox Content="Capture before and after website screenshots for executed changes" IsChecked="{Binding Settings.CaptureBeforeAfterEvidence}" Margin="0,10,0,0"/><CheckBox Content="Only report success after reading and verifying the saved WordPress value" IsChecked="{Binding Settings.RequireVerifiedExecutionResult}" Margin="0,10,0,0"/><TextBlock Text="Minimum splash duration in seconds (3–30)" Margin="0,14,0,6"/><TextBox Text="{Binding Settings.MinimumSplashSeconds, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/><Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" BorderBrush="{DynamicResource PrimaryBrush}"><StackPanel><TextBlock Text="Automation readiness" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Settings.AiAutomationReadiness}" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Settings.AiAutomationSafetySummary}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/><Button Content="Validate AI automation" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Settings.ValidateAiAutomationCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><TextBlock Text="High-risk actions, permanent deletion, credentials, and staging-required changes are never executed silently. Their policy result is displayed to the user with the AI diagnosis." TextWrapping="Wrap"/></Border></StackPanel></Border></StackPanel></ScrollViewer></TabItem><TabItem Header="Jobs &amp; Reliability"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Width="760" HorizontalAlignment="Left" Margin="16"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Failure pause / circuit breaker" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Automatically pause a job type after repeated failures to protect WordPress and avoid retry storms." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/><CheckBox Content="Pause jobs after consecutive failures" IsChecked="{Binding Settings.PauseJobsAfterFailures}"/><UniformGrid Columns="2" Margin="0,14,0,0"><StackPanel Margin="0,0,12,0"><TextBlock Text="Failures before pause (1–20)"/><TextBox Text="{Binding Settings.ConsecutiveJobFailuresBeforePause, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="Pause duration in minutes (1–1440)"/><TextBox Text="{Binding Settings.JobFailurePauseMinutes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></UniformGrid><CheckBox Content="Automatically resume after the pause expires" IsChecked="{Binding Settings.AutoResumeJobsAfterPause}" Margin="0,14,0,0"/><Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><TextBlock Text="The pause is applied per site and per job type. Successful or cancelled jobs reset the consecutive-failure chain." TextWrapping="Wrap"/></Border></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Performance"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Width="760" HorizontalAlignment="Left" Margin="16"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Memory cooling" FontSize="20" FontWeight="SemiBold"/><CheckBox Content="Enable automatic memory cooling" IsChecked="{Binding Settings.EnableMemoryCooling}" Margin="0,12,0,0"/><UniformGrid Columns="3" Margin="0,12,0,0"><StackPanel Margin="0,0,10,0"><TextBlock Text="Start cooling at %"/><TextBox Text="{Binding Settings.MemoryCoolingThresholdPercent}"/></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Text="Resume below %"/><TextBox Text="{Binding Settings.MemoryCoolingResumePercent}"/></StackPanel><StackPanel><TextBlock Text="Check interval (seconds)"/><TextBox Text="{Binding Settings.MemoryCoolingCheckIntervalSeconds}"/></StackPanel></UniformGrid><CheckBox Content="Close child processes started by the application when it exits" IsChecked="{Binding Settings.KillChildProcessesOnExit}" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Safety"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Width="760" HorizontalAlignment="Left" Margin="16"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Destructive WordPress operations" FontSize="20" FontWeight="SemiBold"/><CheckBox Content="Allow moving posts and pages to WordPress Trash" IsChecked="{Binding Settings.EnableContentTrash}" Margin="0,14,0,0"/><CheckBox Content="Allow permanent deletion of posts and pages" IsChecked="{Binding Settings.EnablePermanentContentDelete}" Margin="0,10,0,0"/><CheckBox Content="Allow permanent deletion from the Media Library" IsChecked="{Binding Settings.EnablePermanentMediaDelete}" Margin="0,10,0,0"/><CheckBox Content="Require backup before permanent deletion" IsChecked="{Binding Settings.RequireBackupBeforePermanentDelete}" Margin="0,10,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
     </TabControl>
     <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,22,18"><TextBlock Text="{Binding Settings.StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="500"/><Button Content="Save all settings" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,8,0,0" Command="{Binding Settings.SaveCommand}"/></StackPanel>
