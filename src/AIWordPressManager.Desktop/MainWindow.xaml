       <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="VISUAL SIGNALS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding VisualInspector.TotalIssues}" FontSize="28" FontWeight="Bold"/><TextBlock Text="Review before proposing fixes" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
       <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="LAST RUN" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding VisualInspector.LastRunText}" FontSize="18" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="No automatic network request" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
       <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="TREND" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding VisualInspector.TrendText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Compared with previous run" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
      </UniformGrid>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.85*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
