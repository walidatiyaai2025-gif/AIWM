         <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
         <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <Grid>
            <TextBox Text="{Binding Logs.ApiSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search operation, endpoint, HTTP status, or AI interpretation"/>
            <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Command="{Binding Logs.ClearApiSearchCommand}"/>
           </Grid>
           <DataGrid Grid.Row="1" ItemsSource="{Binding Logs.FilteredWordPressApiItems}" SelectedItem="{Binding Logs.SelectedApiItem}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="500" Margin="0,14,0,0">
            <DataGrid.Columns>
             <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocalText}" Width="145"/>
             <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="170"/>
             <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="70"/>
             <DataGridTextColumn Header="HTTP" Binding="{Binding StatusText}" Width="110"/>
             <DataGridTextColumn Header="Result" Binding="{Binding ResultText}" Width="90"/>
             <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="90"/>
             <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="*"/>
            </DataGrid.Columns>
           </DataGrid>
          </Grid>
         </Border>
         <Border Grid.Column="1" Style="{StaticResource CardStyle}">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <TextBlock Text="Request, response, and AI interpretation" FontSize="20" FontWeight="SemiBold"/>
           <TextBox Grid.Row="1" Text="{Binding Logs.SelectedApiDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="500" Margin="0,14,0,0"/>
          </Grid>
         </Border>
        </Grid>
       </TabItem>
       <TabItem Header="Application log files">
        <Grid Margin="0,16,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <Grid><TextBox Text="{Binding Logs.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search log file names"/><Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Command="{Binding Logs.ClearSearchCommand}"/></Grid>
           <DataGrid Grid.Row="1" ItemsSource="{Binding Logs.FilteredItems}" SelectedItem="{Binding Logs.SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="500" Margin="0,14,0,0"><DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="85"/><DataGridTextColumn Header="Updated" Binding="{Binding LastWriteLocalText}" Width="150"/></DataGrid.Columns></DataGrid>
          </Grid>
         </Border>
         <Border Grid.Column="1" Style="{StaticResource CardStyle}">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="Latest entries (last 250 lines)" FontSize="20" FontWeight="SemiBold"/><Button Content="Open selected" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Command="{Binding Logs.OpenSelectedCommand}"/></Grid><TextBox Grid.Row="1" Text="{Binding Logs.SelectedContent, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="500" Margin="0,14,0,0"/></Grid>
         </Border>
        </Grid>
       </TabItem>
      </TabControl>
     </StackPanel>
    </ScrollViewer>

