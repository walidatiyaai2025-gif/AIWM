       <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="BRAIN READINESS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding SiteBrain.BrainReadiness}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,0"/><CheckBox Content="Enable site autopilot" IsChecked="{Binding SiteBrain.AutopilotEnabled}" Margin="0,12,0,0" ToolTip="Allows eligible low-risk AI actions to follow the site's configured automation policy. Safety, backup, evidence, and verification settings still apply."/></StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource CardStyle}"><StackPanel><UniformGrid Columns="2"><StackPanel Margin="0,0,12,12"><TextBlock Text="Primary AI goal"/><ComboBox SelectedValue="{Binding SiteBrain.PrimaryGoal}" SelectedValuePath="Content" Margin="0,6,0,0"><ComboBoxItem Content="Increase organic traffic"/><ComboBoxItem Content="Grow topical authority"/><ComboBoxItem Content="Improve CTR"/><ComboBoxItem Content="Generate new content"/><ComboBoxItem Content="Fix technical SEO"/><ComboBoxItem Content="Improve conversions"/></ComboBox></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="Publishing schedule"/><TextBox Text="{Binding SiteBrain.PublishingSchedule, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Target keywords"/><TextBox Text="{Binding SiteBrain.TargetKeywords, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" ToolTip="Comma-separated target keywords used by AI planning, content generation, and SEO prioritization."/></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="Competitors"/><TextBox Text="{Binding SiteBrain.Competitors, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" ToolTip="Comma-separated competitor domains or brands used as planning context."/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Primary language"/><TextBox Text="{Binding SiteBrain.PrimaryLanguage, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="Writing tone"/><TextBox Text="{Binding SiteBrain.WritingTone, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Target audience"/><TextBox Text="{Binding SiteBrain.TargetAudience, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="Preferred image size"/><TextBox Text="{Binding SiteBrain.PreferredImageSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="SEO plugin"/><TextBox Text="{Binding SiteBrain.PreferredSeoPlugin, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="Page builder / theme workflow"/><TextBox Text="{Binding SiteBrain.PreferredPageBuilder, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Brand colors"/><TextBox Text="{Binding SiteBrain.BrandColors, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="Internal-link strategy"/><TextBox Text="{Binding SiteBrain.InternalLinkStrategy, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel></UniformGrid><TextBlock Text="Category strategy"/><TextBox Text="{Binding SiteBrain.CategoryStrategy, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/><TextBlock Text="Content rules"/><TextBox Text="{Binding SiteBrain.ContentRules, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="85" Margin="0,6,0,12"/><TextBlock Text="Design rules"/><TextBox Text="{Binding SiteBrain.DesignRules, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="85" Margin="0,6,0,12"/><TextBlock Text="Rejected patterns / lessons learned"/><TextBox Text="{Binding SiteBrain.RejectedPatterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="85" Margin="0,6,0,12"/><TextBlock Text="{Binding SiteBrain.StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer Visibility="{Binding IsPerformanceVisible, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Performance &amp; Memory" FontSize="30" FontWeight="Bold"/><TextBlock Text="Monitor application memory and safely release unused caches and working-set pages." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
          <Button Grid.Column="1" Content="Clean memory now" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CleanDeviceMemoryCommand}" MinWidth="170"/>
        </Grid>
        <UniformGrid Columns="5" Margin="0,24,0,18">
          <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="APP MEMORY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding DashboardMemoryMb, StringFormat={}{0:N0} MB}" FontSize="26" FontWeight="Bold"/><TextBlock Text="Current process working set" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="SYSTEM MEMORY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding SystemMemoryUsagePercent, StringFormat={}{0:N1}%}" FontSize="26" FontWeight="Bold"/><TextBlock Text="Cooling starts automatically at 80%" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding DashboardCpuPercent, StringFormat={}{0:N1}%}" FontSize="26" FontWeight="Bold"/><TextBlock Text="Application CPU usage" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="DATABASE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding DashboardDatabaseSize}" FontSize="26" FontWeight="Bold"/><TextBlock Text="SQLite file size" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
        </UniformGrid>
        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Safe memory cleanup" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="The cleanup releases hidden DataGrid caches, compacts managed memory, and asks Windows to reclaim unused pages from this application. It never terminates or modifies other programs." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/><ProgressBar Height="6" IsIndeterminate="{Binding IsMemoryCleanupRunning}"/><TextBlock Text="{Binding MemoryCleanupStatus}" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="{Binding LastMemoryCleanupResult}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><Button Content="Clean application and device memory" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CleanDeviceMemoryCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Automatic cooling policy" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="At 80% system memory use, the application pauses heavy dashboard refreshes and releases hidden grid caches. Normal refresh resumes only after memory falls below 72%, preventing rapid on/off switching." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding MemoryCoolingStatus}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Border>
      </StackPanel>
    </ScrollViewer>



