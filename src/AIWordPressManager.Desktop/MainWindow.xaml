      </UniformGrid>
      <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Module workspace" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="This screen now has a complete visual layout and is connected to the shared offline-first loading and status framework. Feature-specific tables, filters, charts, and actions will populate this workspace without redesigning the shell." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,18"/><ProgressBar Value="68" Height="8"/><TextBlock Text="UI foundation 68%" Foreground="{DynamicResource PrimaryHoverBrush}" Margin="0,8,0,0"/></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Next implementation" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="• Load saved records
• Add filters and search
• Add primary action
• Add empty/error states
• Connect jobs and audit log" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="24" Margin="0,12,0,0"/></StackPanel></Border>
      </Grid>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <Border Grid.Row="4" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10" Visibility="{Binding IsOperationRunning, Converter={StaticResource BoolToVisibility}}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><StackPanel><Grid><TextBlock Text="{Binding OperationTitle}" FontWeight="SemiBold"/><TextBlock Text="{Binding OperationStep}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding OperationProgress}" Height="8" Margin="0,7,0,5"/><TextBlock Text="{Binding OperationDetail}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding OperationProgress, StringFormat={}{0}%}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryHoverBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   </Border>
   <Border Grid.Row="4" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10" Visibility="{Binding Operations.IsRunning, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><StackPanel><Grid><TextBlock Text="{Binding Operations.Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Operations.Step}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding Operations.Progress}" Height="9" Margin="0,7,0,5"/><TextBlock Text="{Binding Operations.Detail}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Operations.Progress, StringFormat={}{0}%}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryHoverBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   </Border>
   <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding DatabaseStatus}" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Text=" • " Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding ApplicationDataStatus}" Foreground="{DynamicResource PrimaryHoverBrush}" TextTrimming="CharacterEllipsis" MaxWidth="760"/></StackPanel><TextBlock Text="AI WordPress Website Manager • Offline-first" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  <Border Grid.RowSpan="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,174,24,0" Width="230" Padding="14" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Panel.ZIndex="20" Visibility="{Binding IsUserMenuOpen, Converter={StaticResource BoolToVisibility}}">
   <StackPanel><TextBlock Text="Local user" FontWeight="SemiBold"/><TextBlock Text="Application settings and local profile" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,12"/><Button Content="Settings" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings"/><Button Content="Close menu" Style="{StaticResource NavButtonStyle}" Margin="0,6,0,0" Command="{Binding ToggleUserMenuCommand}"/></StackPanel>
  </Border>
  <Grid Grid.RowSpan="6" Background="{DynamicResource OverlayBrush}" Visibility="{Binding Sites.Wizard.IsOpen, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="100">
   <Border Width="980" MaxHeight="820" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="18,0,0,18" Padding="22">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="ADD SITE" Foreground="{DynamicResource PrimaryHoverBrush}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Setup progress" FontSize="21" FontWeight="Bold" Margin="0,7,0,4"/><TextBlock Text="Complete discovery and safety preferences before saving." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/></StackPanel>
       <ScrollViewer Grid.Row="1" Margin="0,22,0,12" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Sites.Wizard.Steps}"><ItemsControl.ItemTemplate><DataTemplate>
         <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusMark}" Foreground="{DynamicResource PrimaryHoverBrush}" FontWeight="Bold" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding Number, StringFormat=Step {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel></Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </ScrollViewer>
       <StackPanel Grid.Row="2"><ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding Sites.Wizard.StepProgress, Mode=OneWay}"/><TextBlock Text="{Binding Sites.Wizard.StepCounter}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0"/></StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Column="1" Margin="30,24,30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><StackPanel><TextBlock Text="Add WordPress Site" FontSize="26" FontWeight="Bold"/><TextBlock Text="{Binding Sites.Wizard.StepTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="All credentials remain local and the Application Password is DPAPI protected." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButtonStyle}" Command="{Binding Sites.Wizard.CancelCommand}" ToolTip="Close wizard"/></Grid>
      <ScrollViewer Grid.Row="1" Margin="0,25,0,22" VerticalScrollBarVisibility="Auto"><Grid>
       <StackPanel Visibility="{Binding Sites.Wizard.ShowBasicStep, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Site name"/><TextBox Text="{Binding Sites.Wizard.SiteName, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,18"/><TextBlock Text="Website URL"/><TextBox Text="{Binding Sites.Wizard.SiteUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,10"/><TextBlock Text="Use the public HTTPS URL, for example https://example.com" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
       <StackPanel Visibility="{Binding Sites.Wizard.ShowAuthenticationStep, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="WordPress username"/><TextBox Text="{Binding Sites.Wizard.UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,18"/><TextBlock Text="Application Password"/><PasswordBox x:Name="WordPressPasswordBox" PasswordChanged="WordPressPasswordBox_OnPasswordChanged" Margin="0,7,0,8"/><TextBlock Text="Password captured securely" Foreground="{DynamicResource SuccessBrush}" Visibility="{Binding Sites.Wizard.HasCapturedPassword, Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="Create it in WordPress: Users → Profile → Application Passwords. Spaces are accepted and normalized automatically." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
       <StackPanel Visibility="{Binding Sites.Wizard.ShowConnectionStep, Converter={StaticResource BoolToVisibility}}"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="REST API and authentication test" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Reads /wp-json/ and authenticates against /wp-json/wp/v2/users/me. No content is changed." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/><StackPanel Orientation="Horizontal"><Button Content="Test connection" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Command="{Binding Sites.Wizard.TestConnectionCommand}"/><Button Content="View diagnostics" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Command="{Binding Sites.Wizard.ShowDiagnosticsCommand}"/></StackPanel><TextBlock Text="{Binding Sites.Wizard.ConnectionMessage}" Margin="0,18,0,0" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
       <StackPanel Visibility="{Binding Sites.Wizard.ShowDiscoveryStep, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Site discovery result" FontSize="18" FontWeight="SemiBold"/><Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><TextBlock Text="{Binding Sites.Wizard.DiscoverySummary}" TextWrapping="Wrap" LineHeight="24"/></Border><TextBlock Text="Full namespaces, post types, taxonomies, sitemap and robots.txt discovery will be handled by the initial scan job." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel>
       <StackPanel Visibility="{Binding Sites.Wizard.ShowSeoStep, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="SEO plugin detection" FontSize="18" FontWeight="SemiBold"/><Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Detection prepared" FontWeight="SemiBold"/><TextBlock Text="The initial scan will detect Yoast SEO, Rank Math, AIOSEO and SEOPress through registered REST namespaces and connector capabilities." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border></StackPanel>
       <StackPanel Visibility="{Binding Sites.Wizard.ShowBuilderStep, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Page builder detection" FontSize="18" FontWeight="SemiBold"/><Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><TextBlock Text="Gutenberg, Elementor, Divi, WPBakery and Classic Editor adapters will be selected after discovery. No theme or page-builder data is modified during setup." TextWrapping="Wrap"/></Border></StackPanel>
       <StackPanel Visibility="{Binding Sites.Wizard.ShowWooCommerceStep, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="WooCommerce detection" FontSize="18" FontWeight="SemiBold"/><Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><TextBlock Text="The initial scan will check WooCommerce REST namespaces. Store changes remain disabled unless explicit credentials and approval are configured later." TextWrapping="Wrap"/></Border></StackPanel>
       <StackPanel Visibility="{Binding Sites.Wizard.ShowAiStep, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="AI configuration" FontSize="18" FontWeight="SemiBold"/><CheckBox Content="Enable AI analysis and recommendations for this site" IsChecked="{Binding Sites.Wizard.EnableAiFeatures}" Margin="0,18,0,8"/><TextBlock Text="AI remains advisory. Every proposed modification is stored as a Suggested Change and must pass preview and approval." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
       <StackPanel Visibility="{Binding Sites.Wizard.ShowStagingStep, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Staging configuration" FontSize="18" FontWeight="SemiBold"/><CheckBox Content="Require staging for high-risk changes" IsChecked="{Binding Sites.Wizard.UseStagingForHighRiskChanges}" Margin="0,18,0,14"/><TextBlock Text="Optional staging URL"/><TextBox Text="{Binding Sites.Wizard.StagingUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0"/><TextBlock Text="You may leave it blank now and configure staging credentials later." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/></StackPanel>
       <StackPanel Visibility="{Binding Sites.Wizard.ShowPermissionsStep, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Permissions and automation" FontSize="18" FontWeight="SemiBold"/><CheckBox Content="Allow creation of WordPress drafts" IsChecked="{Binding Sites.Wizard.AllowDraftCreation}" Margin="0,18,0,10"/><CheckBox Content="Allow automatic publishing (not recommended)" IsChecked="{Binding Sites.Wizard.AllowAutomaticPublishing}"/><Border Style="{StaticResource CardStyle}" Margin="0,18,0,0"><TextBlock Text="Bulk and high-risk execution always requires backup, explicit approval and a rollback plan regardless of these preferences." TextWrapping="Wrap"/></Border></StackPanel>
       <StackPanel Visibility="{Binding Sites.Wizard.ShowSummaryStep, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Initial scan summary" FontSize="18" FontWeight="SemiBold"/><Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><TextBlock Text="The site is ready for registration." FontWeight="SemiBold"/><TextBlock Text="After saving, a later phase will queue SiteScan, SEO Audit, Content Scan and Design Audit jobs. This setup step does not change WordPress content." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></StackPanel>
       <StackPanel Visibility="{Binding Sites.Wizard.ShowReviewStep, Converter={StaticResource BoolToVisibility}}"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Ready to save" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Sites.Wizard.SiteName}" FontSize="22" FontWeight="Bold" Margin="0,18,0,4"/><TextBlock Text="{Binding Sites.Wizard.SiteUrl}" Foreground="{DynamicResource TextSecondaryBrush}"/><Separator Margin="0,16" Background="{DynamicResource BorderBrush}"/><TextBlock Text="Connection verified. Credentials will be stored only in DPAPI-protected form. No WordPress content will be changed." TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}"/></StackPanel></Border></StackPanel>
      </Grid></ScrollViewer>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Sites.Wizard.ValidationMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Back" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Command="{Binding Sites.Wizard.BackCommand}" Visibility="{Binding Sites.Wizard.IsFirstStep, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/><Button Content="Next" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Sites.Wizard.NextCommand}" Visibility="{Binding Sites.Wizard.IsLastStep, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/><Button Content="Save site" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Sites.Wizard.SaveCommand}" Visibility="{Binding Sites.Wizard.IsLastStep, Converter={StaticResource BoolToVisibility}}"/></StackPanel></Grid>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.RowSpan="6" Panel.ZIndex="200" Background="{DynamicResource OverlayBrush}" Visibility="{Binding Sites.Wizard.IsDiagnosticsOpen, Converter={StaticResource BoolToVisibility}}">
   <Border Width="900" MaxHeight="720" Padding="24" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><StackPanel><TextBlock Text="{Binding Sites.Wizard.DiagnosticsTitle}" FontSize="22" FontWeight="Bold"/><TextBlock Text="The Authorization header and Application Password are always redacted. Full details are also written to the application log." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,40,0"/></StackPanel><Button Grid.Column="1" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButtonStyle}" Command="{Binding Sites.Wizard.CloseDiagnosticsCommand}"/></Grid>
     <TextBox Grid.Row="1" Text="{Binding Sites.Wizard.DiagnosticsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,18,0,18" MinHeight="380"/>
     <Grid Grid.Row="2"><TextBlock Text="Check the Logs folder for the complete Serilog record." Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/><Button Content="Close" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Command="{Binding Sites.Wizard.CloseDiagnosticsCommand}"/></Grid>
    </Grid>
   </Border>
  </Border>

 

  <!-- Global operation lock: blocks navigation and commands while a long-running action is in progress. -->
  <Grid Grid.RowSpan="6" Panel.ZIndex="1450"
        Visibility="{Binding Operations.IsRunning, Converter={StaticResource BoolToVisibility}}"
        Background="#99000000">
   <Border Width="620" MaxWidth="760" Padding="28" CornerRadius="16"
           Background="{DynamicResource SurfaceBrush}"
           BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5"
           HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel>
      <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0">
       <TextBlock Text="AI" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel>
       <TextBlock Text="{Binding Operations.Title}" FontSize="22" FontWeight="Bold"/>
       <TextBlock Text="{Binding Operations.Step}" Margin="0,5,0,0" Foreground="{DynamicResource PrimaryHoverBrush}" FontWeight="SemiBold"/>
      </StackPanel>
     </DockPanel>
     <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding Operations.Progress}"
                  IsIndeterminate="{Binding Operations.IsIndeterminate}" Height="10" Margin="0,24,0,10"/>
     <Grid Grid.Row="2">
      <TextBlock Text="{Binding Operations.Detail}" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,70,0"/>
      <TextBlock Text="{Binding Operations.Progress, StringFormat={}{0}%}" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryHoverBrush}"/>
     </Grid>
     <Border Grid.Row="3" Margin="0,20,0,0" Padding="12,9" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
      <TextBlock Text="Please wait. Navigation and site selection are temporarily locked so the current operation cannot change context." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
     </Border>
    </Grid>
   </Border>
  </Grid>

  <!-- Contextual help mode indicator. Help mode prevents commands from executing and opens the selected control instructions instead. -->
  <Border x:Name="HelpModeBanner" Grid.RowSpan="3" Panel.ZIndex="1500" Visibility="Collapsed"
          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,42,0,0"
          Padding="16,8" CornerRadius="16" Background="{DynamicResource PrimaryBrush}"
          BorderBrush="{DynamicResource PrimaryHoverBrush}" BorderThickness="1.5" IsHitTestVisible="False">
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="?" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Bold" FontSize="16" Margin="0,0,8,0"/>
    <TextBlock Text="HELP MODE • Hover for guidance, click any control for full instructions, F1 to exit" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold"/>
   </StackPanel>
  </Border>

  <!-- Non-blocking memory pressure indicator. It appears above every screen and
       remains visible until Windows memory usage drops below the safe hysteresis level. -->
  <Border x:Name="CoolingBadge" Grid.RowSpan="6" Panel.ZIndex="1000"
          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
          Padding="18,10" CornerRadius="18" Background="{DynamicResource CoolingBackgroundBrush}"
          BorderBrush="{DynamicResource CoolingBorderBrush}" BorderThickness="1.5"
          Visibility="{Binding IsMemoryCooling, Converter={StaticResource BoolToVisibility}}"
          IsHitTestVisible="False">
   <Border.Style>
    <Style TargetType="Border">
     <Style.Triggers>
      <DataTrigger Binding="{Binding IsMemoryCooling}" Value="True">
       <DataTrigger.EnterActions>
        <BeginStoryboard x:Name="CoolingBorderPulse">
         <Storyboard RepeatBehavior="Forever" AutoReverse="True">
          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.62" To="1" Duration="0:0:0.7"/>
         </Storyboard>
        </BeginStoryboard>
       </DataTrigger.EnterActions>
       <DataTrigger.ExitActions>
        <StopStoryboard BeginStoryboardName="CoolingBorderPulse"/>
       </DataTrigger.ExitActions>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </Border.Style>
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="❄" FontSize="24" Foreground="{DynamicResource CoolingBorderBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
     <TextBlock.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></TextBlock.RenderTransform>
     <TextBlock.Style>
      <Style TargetType="TextBlock">
       <Style.Triggers>
        <DataTrigger Binding="{Binding IsMemoryCooling}" Value="True">
         <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="CoolingIconPulse">
           <Storyboard RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.92" To="1.12" Duration="0:0:0.7"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.92" To="1.12" Duration="0:0:0.7"/>
           </Storyboard>
          </BeginStoryboard>
         </DataTrigger.EnterActions>
         <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="CoolingIconPulse"/>
         </DataTrigger.ExitActions>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    <StackPanel Margin="10,0,0,0">
     <TextBlock Text="MEMORY COOLING MODE" Foreground="White" FontWeight="Bold" FontSize="12"/>
     <TextBlock Text="{Binding MemoryCoolingStatus}" Foreground="{DynamicResource CoolingTextBrush}" FontSize="11"/>
    </StackPanel>
   </StackPanel>
  </Border>
</Grid>
</Window>
