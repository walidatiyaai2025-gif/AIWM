      <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Reload" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Orchestrator.LoadCommand}"/><Button Content="Save policy" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Command="{Binding Orchestrator.SavePolicyCommand}"/><Button Content="Run full workflow" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" Command="{Binding Orchestrator.RunFullWorkflowCommand}"/><Button Content="Evidence" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="Evidence Center"/><Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Command="{Binding Orchestrator.CancelCommand}"/></WrapPanel>
     </Grid>
     <Grid Grid.Row="1" Margin="0,22,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
