Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Command="{Binding PostEditor.BulkUpdateCommand}"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Measurable SEO preview" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding PostEditor.SeoScore, StringFormat=Score: {0}/100}" FontSize="30" FontWeight="Bold" Margin="0,10,0,8"/><TextBlock Text="{Binding PostEditor.SeoSummary}" TextWrapping="Wrap" LineHeight="22"/><Separator Margin="0,16"/><TextBlock Text="Yoast, Rank Math, AIOSEO and SEOPress fields will be editable only when their REST metadata is exposed or the secure companion connector is installed. The editor will not invent unsupported meta fields." Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding PostEditor.StatusMessage}" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border>
