       </Border>
      </Grid>
      <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
       <StackPanel><TextBlock Text="Inspection history" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Offline runs are retained so you can verify whether visual quality is improving." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,12"/>
