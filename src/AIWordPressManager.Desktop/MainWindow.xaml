          <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Missing ALT" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding VisualInspector.SelectedResult.MissingAltImages}" FontWeight="Bold" FontSize="18"/></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Small targets" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding VisualInspector.SelectedResult.SmallTouchTargets}" FontWeight="Bold" FontSize="18"/></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Console errors" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding VisualInspector.SelectedResult.ConsoleErrors.Count}" FontWeight="Bold" FontSize="18"/></StackPanel></Border>
