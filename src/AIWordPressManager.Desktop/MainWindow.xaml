         <DataGrid.Columns><DataGridTextColumn Header="Run" Binding="{Binding RunAtDisplay}" Width="170"/><DataGridTextColumn Header="Viewports" Binding="{Binding Viewports}" Width="90"/><DataGridTextColumn Header="Signals" Binding="{Binding TotalIssues}" Width="90"/><DataGridTextColumn Header="Missing ALT" Binding="{Binding MissingAltImages}" Width="100"/><DataGridTextColumn Header="Broken images" Binding="{Binding BrokenImages}" Width="110"/><DataGridTextColumn Header="Touch targets" Binding="{Binding SmallTouchTargets}" Width="110"/><DataGridTextColumn Header="Summary" Binding="{Binding TrendSummary}" Width="*"/></DataGrid.Columns>
        </DataGrid>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.9*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,18,0">
         <TextBlock Text="Before / after verification" FontSize="20" FontWeight="SemiBold"/>
         <TextBlock Text="Compares the two most recent responsive inspections without contacting WordPress." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,14" TextWrapping="Wrap"/>
         <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
          <StackPanel>
           <TextBlock Text="LATEST CHANGE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
           <TextBlock Text="{Binding VisualInspector.ComparisonSummary}" FontSize="20" FontWeight="Bold" Margin="0,7,0,0" TextWrapping="Wrap"/>
           <TextBlock Text="Run another inspection after applying approved design fixes to verify the result." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
          </StackPanel>
         </Border>
        </StackPanel>
        <DataGrid Grid.Column="1" ItemsSource="{Binding VisualInspector.ComparisonRows}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="150" MaxHeight="220">
         <DataGrid.Columns>
          <DataGridTextColumn Header="Viewport" Binding="{Binding ViewportName}" Width="110"/>
          <DataGridTextColumn Header="Before" Binding="{Binding PreviousIssues}" Width="85"/>
          <DataGridTextColumn Header="After" Binding="{Binding LatestIssues}" Width="85"/>
          <DataGridTextColumn Header="Change" Binding="{Binding ChangeLabel}" Width="*"/>
         </DataGrid.Columns>
        </DataGrid>
       </Grid>
      </Border>
     </StackPanel>
    </ScrollViewer>

    <Grid Visibility="{Binding IsOrchestratorVisible, Converter={StaticResource BoolToVisibility}}" Margin="30">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
