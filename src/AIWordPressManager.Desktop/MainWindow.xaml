       <StackPanel>
        <TextBlock Text="Execution &amp; Diagnostics Logs" FontSize="30" FontWeight="Bold"/>
        <TextBlock Text="Inspect application diagnostics and the exact request/response returned by WordPress during execution." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
