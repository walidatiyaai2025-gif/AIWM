      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
       <StackPanel><Grid><TextBlock Text="{Binding Jobs.StatusMessage}" TextWrapping="Wrap"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock Text="{Binding Jobs.AutoRefreshText}" Foreground="{DynamicResource TextSecondaryBrush}"/><Button Content="Show failed" Style="{StaticResource SecondaryButtonStyle}" Margin="12,-8,0,-8" Command="{Binding Jobs.ShowFailedCommand}"/></StackPanel></Grid><ProgressBar Value="{Binding Jobs.ProgressPercent}" Maximum="100" Height="7" Margin="0,12,0,5"/><TextBlock Text="{Binding Jobs.CurrentStep}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel>
      </Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
