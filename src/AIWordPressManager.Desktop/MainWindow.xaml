<Window x:Class="AIWordPressManager.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:b="clr-namespace:AIWordPressManager.Desktop.Behaviors" xmlns:views="clr-namespace:AIWordPressManager.Desktop.Views"
 Title="AI WordPress Management" Icon="Assets/Brand/app_icon.ico" PreviewKeyDown="MainWindow_OnPreviewKeyDown" Width="1440" Height="900" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Window.InputBindings>
  <KeyBinding Key="F1" Modifiers="Shift" Command="{Binding Help.OpenGuideCommand}"/>
  <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
  <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Sites"/>
  <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="WordPress Explorer"/>
  <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="SEO Audit"/>
  <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Suggested Changes"/>
  <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Execution Center"/>
  <KeyBinding Key="D7" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Jobs"/>
  <KeyBinding Key="D8" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
  <KeyBinding Key="H" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Help"/>
  <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding RefreshCurrentPageCommand}"/>
  <KeyBinding Key="L" Modifiers="Control+Shift" Command="{Binding ToggleLanguageCommand}"/>
  <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding ToggleThemeCommand}"/>
 </Window.InputBindings>
 <Grid FlowDirection="{Binding FlowDirection}" Background="{DynamicResource AppBackgroundBrush}">
  <Grid.RowDefinitions>
   <RowDefinition Height="46"/>
   <RowDefinition Height="132"/>
   <RowDefinition Height="36"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="30"/>
  </Grid.RowDefinitions>

  <!-- Office-style title and Quick Access Toolbar -->
  <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
   <Grid Margin="10,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="36" Height="36" CornerRadius="10" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
      <Image Source="Assets/Brand/app_icon_128.png" Stretch="Uniform" Margin="3"/>
     </Border>
     <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
      <TextBlock Text="AI WordPress" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
      <TextBlock Text="MANAGEMENT" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
     </StackPanel>
     <Button Content="⌂" ToolTip="Dashboard (Ctrl+1)" Style="{StaticResource RibbonQuickButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
     <Button Content="↻" ToolTip="Refresh current screen (Ctrl+Shift+R)" Style="{StaticResource RibbonQuickButtonStyle}" Command="{Binding RefreshCurrentPageCommand}"/>
     <Button Content="⚡" ToolTip="Suggested Changes" Style="{StaticResource RibbonQuickButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Suggested Changes"/>
     <Button Content="▶" ToolTip="Execution Center" Style="{StaticResource RibbonQuickButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Execution Center"/>
    </StackPanel>
    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock Text="Smart Tools. Better Sites. Real Results." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
     <Border Height="2" Width="150" Background="{DynamicResource PrimaryBrush}" CornerRadius="1" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding DashboardSelectedSite, StringFormat=Active: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
     <Button x:Name="HelpModeButton" Content="?" ToolTip="Context help mode (F1). Hover for instructions; click a control for full help." Style="{StaticResource RibbonQuickButtonStyle}" Click="HelpModeButton_OnClick"/>
     <Button Content="{Binding ThemeIcon}" ToolTip="Light / dark mode" Style="{StaticResource RibbonQuickButtonStyle}" Command="{Binding ToggleThemeCommand}"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- Main Ribbon -->
  <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
   <TabControl Style="{StaticResource OfficeRibbonTabControlStyle}" Margin="8,0,8,4">
    <TabItem Header="HOME">
     <Grid Margin="8,6,8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal">
       <Button Style="{StaticResource RibbonLargeButtonStyle}" Content="⌂&#10;Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
       <Button Style="{StaticResource RibbonLargeButtonStyle}" Content="◉&#10;Sites" Command="{Binding NavigateCommand}" CommandParameter="Sites"/>
       <Button Style="{StaticResource RibbonLargeButtonStyle}" Content="▣&#10;Explorer" Command="{Binding NavigateCommand}" CommandParameter="WordPress Explorer"/>
      </StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal">
       <Button Style="{StaticResource RibbonLargeButtonStyle}" Content="⚡&#10;AI Run" Command="{Binding NavigateCommand}" CommandParameter="Suggested Changes"/>
       <Button Style="{StaticResource RibbonLargeButtonStyle}" Content="✓&#10;Approve" Command="{Binding NavigateCommand}" CommandParameter="Approval Queue"/>
       <Button Style="{StaticResource RibbonLargeButtonStyle}" Content="▶&#10;Execute" Command="{Binding NavigateCommand}" CommandParameter="Execution Center"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal">
       <Button Style="{StaticResource RibbonSmallButtonStyle}" Content="↻  Refresh" Command="{Binding RefreshCurrentPageCommand}"/>
       <Button Style="{StaticResource RibbonSmallButtonStyle}" Content="🔔  Notifications" Command="{Binding ShowNotificationsCommand}"/>
      </StackPanel></Border>
      <Border Grid.Column="5" Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal">
       <Button Content="{Binding LanguageLabel}" Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding ToggleLanguageCommand}"/>
       <Button x:Name="AccentPaletteButton" Content="◉  Colors" Style="{StaticResource RibbonSmallButtonStyle}" Click="AccentPaletteButton_OnClick">
        <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
         <MenuItem Header="Brand Teal" Command="{Binding ApplyAccentPaletteCommand}" CommandParameter="Brand Teal"/><MenuItem Header="Midnight Azure" Command="{Binding ApplyAccentPaletteCommand}" CommandParameter="Midnight Azure"/><MenuItem Header="Emerald Slate" Command="{Binding ApplyAccentPaletteCommand}" CommandParameter="Emerald Slate"/><MenuItem Header="Violet Pulse" Command="{Binding ApplyAccentPaletteCommand}" CommandParameter="Violet Pulse"/><MenuItem Header="Ocean Cyan" Command="{Binding ApplyAccentPaletteCommand}" CommandParameter="Ocean Cyan"/><MenuItem Header="Crimson Ember" Command="{Binding ApplyAccentPaletteCommand}" CommandParameter="Crimson Ember"/><MenuItem Header="Graphite Gold" Command="{Binding ApplyAccentPaletteCommand}" CommandParameter="Graphite Gold"/><MenuItem Header="Rose Quartz" Command="{Binding ApplyAccentPaletteCommand}" CommandParameter="Rose Quartz"/>
        </ContextMenu></Button.ContextMenu>
       </Button>
      </StackPanel></Border>
     </Grid>
    </TabItem>
    <TabItem Header="SITE &amp; DATA">
     <StackPanel Orientation="Horizontal" Margin="10,6">
      <Border Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="◉&#10;Sites" Command="{Binding NavigateCommand}" CommandParameter="Sites"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="▣&#10;Explorer" Command="{Binding NavigateCommand}" CommandParameter="WordPress Explorer"/></StackPanel></Border>
      <Border Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="⟳&#10;Backup" Command="{Binding NavigateCommand}" CommandParameter="Backups"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="▥&#10;Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="≣&#10;API Logs" Command="{Binding NavigateCommand}" CommandParameter="Logs"/></StackPanel></Border>
     </StackPanel>
    </TabItem>
    <TabItem Header="CONTENT &amp; SEO">
     <StackPanel Orientation="Horizontal" Margin="10,6">
      <Border Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="✓&#10;Content Audit" Command="{Binding NavigateCommand}" CommandParameter="Content Audit"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="↗&#10;SEO Audit" Command="{Binding NavigateCommand}" CommandParameter="SEO Audit"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="⌁&#10;SEO History" Command="{Binding NavigateCommand}" CommandParameter="SEO History"/></StackPanel></Border>
      <Border Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="▦&#10;Categories" Command="{Binding NavigateCommand}" CommandParameter="Category Planner"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="≡&#10;Planner" Command="{Binding NavigateCommand}" CommandParameter="Content Planner"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="✦&#10;Article" Command="{Binding NavigateCommand}" CommandParameter="Article Generator"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="⇄&#10;Links" Command="{Binding NavigateCommand}" CommandParameter="Internal Links"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="✎&#10;SEO Editor" Command="{Binding NavigateCommand}" CommandParameter="Post SEO Editor"/></StackPanel></Border>
     </StackPanel>
    </TabItem>
    <TabItem Header="DESIGN &amp; QUALITY">
     <StackPanel Orientation="Horizontal" Margin="10,6">
      <Border Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="◫&#10;Theme" Command="{Binding NavigateCommand}" CommandParameter="Theme Inspector"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="◉&#10;Visual" Command="{Binding NavigateCommand}" CommandParameter="Visual Inspector"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="✎&#10;Visual Editor" Command="{Binding NavigateCommand}" CommandParameter="Visual WordPress Editor"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="◫&#10;Design" Command="{Binding NavigateCommand}" CommandParameter="Design Audit"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="▤&#10;Responsive" Command="{Binding NavigateCommand}" CommandParameter="Responsive Audit"/></StackPanel></Border>
      <Border Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="⚡&#10;Performance" Command="{Binding NavigateCommand}" CommandParameter="Performance"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="♿&#10;Accessibility" Command="{Binding NavigateCommand}" CommandParameter="Accessibility"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="⛓&#10;Broken Links" Command="{Binding NavigateCommand}" CommandParameter="Broken Links"/></StackPanel></Border>
     </StackPanel>
    </TabItem>
    <TabItem Header="AI &amp; AUTOMATION">
     <StackPanel Orientation="Horizontal" Margin="10,6">
      <Border Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="▣&#10;Operations" Command="{Binding NavigateCommand}" CommandParameter="Operations Center"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="⚡&#10;Action Center" Command="{Binding NavigateCommand}" CommandParameter="Action Center"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="✦&#10;AI Studio" Command="{Binding NavigateCommand}" CommandParameter="AI Studio"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="◈&#10;Site Brain" Command="{Binding NavigateCommand}" CommandParameter="AI Site Brain"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="⚙&#10;Autopilot" Command="{Binding NavigateCommand}" CommandParameter="AI Autopilot"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="◆&#10;Decisions" Command="{Binding NavigateCommand}" CommandParameter="AI Decision Center"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="⇄&#10;Transactions" Command="{Binding NavigateCommand}" CommandParameter="Transaction Center"/></StackPanel></Border>
      <Border Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="!&#10;Changes" Command="{Binding NavigateCommand}" CommandParameter="Suggested Changes"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="✓&#10;Approval" Command="{Binding NavigateCommand}" CommandParameter="Approval Queue"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="▶&#10;Execution" Command="{Binding NavigateCommand}" CommandParameter="Execution Center"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="⌫&#10;Deletion" Command="{Binding NavigateCommand}" CommandParameter="Deletion Center"/></StackPanel></Border>
     </StackPanel>
    </TabItem>
    <TabItem Header="SYSTEM">
     <StackPanel Orientation="Horizontal" Margin="10,6">
      <Border Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="▶&#10;Jobs" Command="{Binding NavigateCommand}" CommandParameter="Jobs"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="🔔&#10;Notifications" Command="{Binding NavigateCommand}" CommandParameter="Notification Center"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="◷&#10;Timeline" Command="{Binding NavigateCommand}" CommandParameter="Activity Timeline"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="▧&#10;Evidence" Command="{Binding NavigateCommand}" CommandParameter="Evidence Center"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="◷&#10;Scheduler" Command="{Binding NavigateCommand}" CommandParameter="Scheduler Center"/></StackPanel></Border>
      <Border Style="{StaticResource RibbonGroupStyle}"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="▣&#10;Memory" Command="{Binding NavigateCommand}" CommandParameter="Performance"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="✓&#10;Release" Command="{Binding NavigateCommand}" CommandParameter="Release Readiness"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="❤&#10;Health" Command="{Binding NavigateCommand}" CommandParameter="Health Center"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="◫&#10;Plugins" Command="{Binding NavigateCommand}" CommandParameter="Plugin Compatibility"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="⚙&#10;Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"/><Button Style="{StaticResource RibbonLargeButtonStyle}" Content="?&#10;Help" Command="{Binding NavigateCommand}" CommandParameter="Help"/></StackPanel></Border>
     </StackPanel>
    </TabItem>
   </TabControl>
  </Border>

  <!-- Context strip under the ribbon -->
  <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,4">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding PageTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Border Grid.Column="1" Margin="12,0,0,0" Padding="8,2" CornerRadius="5" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="{Binding DashboardSelectedSite, StringFormat=ACTIVE SITE: {0}}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="11"/></Border>
    <TextBlock Grid.Column="2" Text="{Binding ConnectionStatus}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0" VerticalAlignment="Center"/>
    <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2">
     <DockPanel><TextBlock Text="⌕" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/><TextBox x:Name="SidebarSearchBox" TextChanged="SidebarSearchBox_OnTextChanged" Background="Transparent" BorderThickness="0" Padding="0" ToolTip="Search commands (Ctrl+K)"/></DockPanel>
    </Border>
   </Grid>
  </Border>

  <!-- Retained hidden navigation tree for command search compatibility. -->
  <StackPanel x:Name="SidebarNavigationRoot" Visibility="Collapsed" PreviewMouseLeftButtonUp="SidebarNavigationRoot_OnPreviewMouseLeftButtonUp">
   <Button Content="Dashboard" Tag="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/><Button Content="Sites" Tag="Sites" Command="{Binding NavigateCommand}" CommandParameter="Sites"/><Button Content="WordPress Explorer" Tag="WordPress Explorer" Command="{Binding NavigateCommand}" CommandParameter="WordPress Explorer"/><Button Content="Content Audit" Tag="Content Audit" Command="{Binding NavigateCommand}" CommandParameter="Content Audit"/><Button Content="SEO Audit" Tag="SEO Audit" Command="{Binding NavigateCommand}" CommandParameter="SEO Audit"/><Button Content="Suggested Changes" Tag="Suggested Changes" Command="{Binding NavigateCommand}" CommandParameter="Suggested Changes"/><Button Content="Execution Center" Tag="Execution Center" Command="{Binding NavigateCommand}" CommandParameter="Execution Center"/><Button Content="Settings" Tag="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"/><Button Content="Visual WordPress Editor" Tag="Visual WordPress Editor" Command="{Binding NavigateCommand}" CommandParameter="Visual WordPress Editor"/>
  </StackPanel>
   <Grid Grid.Row="3">
    <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}" Margin="30">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="AI WordPress Optimization Journey" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Analyze, preview, approve, execute, and verify through one clear guided experience." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="⚡  AI Run" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Suggested Changes"/><Button Content="↻  Refresh" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/></StackPanel>
     </Grid>
     <TabControl Grid.Row="1" Margin="0,20,0,0" Padding="0" Background="Transparent" BorderThickness="0">
      <TabItem Header="SEO Journey">
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,16,0,0">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="0.72*"/><ColumnDefinition Width="1.28*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,9,0" Padding="26">
           <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <StackPanel><TextBlock Text="WEBSITE SEO SCORE" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding DashboardSelectedSite}" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
             <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="12,6"><TextBlock Text="{Binding DashboardSeoScoreState}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/></Border>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,0" VerticalAlignment="Bottom"><TextBlock Text="{Binding DashboardHealthScore}" FontSize="76" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/><TextBlock Text="/100" FontSize="22" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,12"/></StackPanel>
            <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="{Binding DashboardHealthLabel}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding DashboardSeoScoreSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/><WrapPanel Margin="0,12,0,0"><Border Background="{DynamicResource SoftSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="PROJECTED AFTER SAFE PLAN" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock Text="{Binding DashboardProjectedScore, StringFormat={}{0}/100}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/></StackPanel></Border><Border Background="{DynamicResource SoftSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8"><StackPanel><TextBlock Text="ESTIMATED GAIN" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock Text="{Binding DashboardEstimatedGain}" Foreground="{DynamicResource SuccessBrush}" FontSize="16" FontWeight="Bold"/></StackPanel></Border></WrapPanel></StackPanel>
            <WrapPanel Grid.Row="3" Margin="0,22,0,0"><Button Content="Start optimization" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartOptimizationCommand}" MinWidth="190" Margin="0,0,9,8"/><Button Content="Refresh score" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCurrentPageCommand}" Margin="0,0,9,8"/><Button Content="SEO history" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="SEO History" Margin="0,0,0,8"/></WrapPanel>
            <Border Grid.Row="4" Margin="0,14,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource SoftSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="{Binding IsGuidedAnalysisRunning, Converter={StaticResource BoolToVisibility}}">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding GuidedAnalysisStage}" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Text="{Binding GuidedAnalysisDetail}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/>
                <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding GuidedAnalysisProgress}" Height="8"/>
              </Grid>
            </Border>
           </Grid>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="9,0,0,0" Padding="24">
           <StackPanel>
            <Grid><StackPanel><TextBlock Text="Guided optimization workflow" FontSize="22" FontWeight="Bold"/><TextBlock Text="Follow one clear path from analysis to verified WordPress execution." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel><TextBlock Text="{Binding DashboardJourneyProgress, StringFormat={}{0}% complete}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/></Grid>
            <ProgressBar Value="{Binding DashboardJourneyProgress}" Maximum="100" Height="8" Margin="0,18,0,14"/>
            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
             <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="RECOMMENDED NEXT ACTION" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding CurrentJourneyStepTitle}" FontSize="17" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="{Binding CurrentJourneyStepDescription}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,14,0"/></StackPanel><Button Grid.Column="1" Content="{Binding CurrentJourneyActionLabel}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ContinueJourneyCommand}" VerticalAlignment="Center" MinWidth="150"/></Grid>
            </Border>
            <UniformGrid Columns="1">
             <Button Style="{StaticResource NavigationCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="SEO Audit" Margin="0,0,0,7" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" Background="{Binding JourneyAnalyzeBrush}"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Analyze website" FontWeight="Bold"/><TextBlock Text="Crawl SEO, content, links and taxonomy; save the baseline score." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding JourneyAnalyzeState}" Foreground="{Binding JourneyAnalyzeBrush}" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Button>
             <Button Style="{StaticResource NavigationCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Suggested Changes" Margin="0,0,0,7" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" Background="{Binding JourneyAiReviewBrush}"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="AI review" FontWeight="Bold"/><TextBlock Text="Convert findings into concrete actions with impact and risk." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding JourneyAiReviewState}" Foreground="{Binding JourneyAiReviewBrush}" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Button>
             <Button Style="{StaticResource NavigationCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Suggested Changes" Margin="0,0,0,7" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" Background="{Binding JourneyPreviewBrush}"><TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Preview changes" FontWeight="Bold"/><TextBlock Text="Review current and proposed values, evidence and execution route." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding JourneyPreviewState}" Foreground="{Binding JourneyPreviewBrush}" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Button>
             <Button Style="{StaticResource NavigationCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Approval Queue" Margin="0,0,0,7" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" Background="{Binding JourneyApprovalBrush}"><TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Approve plan" FontWeight="Bold"/><TextBlock Text="Confirm allowed changes; protected operations remain blocked." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding JourneyApprovalState}" Foreground="{Binding JourneyApprovalBrush}" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Button>
             <Button Style="{StaticResource NavigationCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Execution Center" Margin="0,0,0,7" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" Background="{Binding JourneyExecuteBrush}"><TextBlock Text="5" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Execute safely" FontWeight="Bold"/><TextBlock Text="Backup, write through WordPress, log responses and retain rollback." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding JourneyExecuteState}" Foreground="{Binding JourneyExecuteBrush}" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Button>
