         </DataGrid>
        </StackPanel>
       </Border>
       <Border Grid.Column="1" Style="{StaticResource CardStyle}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="360"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Grid><StackPanel><TextBlock Text="Selected evidence" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding VisualInspector.SelectedResult.ScreenshotPath, TargetNullValue=Run an inspection to create screenshots}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="620"/></StackPanel><Button Content="Open image" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding VisualInspector.OpenScreenshotCommand}"/></Grid>
         <Border Grid.Row="1" Background="{DynamicResource ControlSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,14,0,14"><Image Source="{Binding VisualInspector.SelectedResult.ScreenshotPath}" Stretch="Uniform" Margin="8"/></Border>
         <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
