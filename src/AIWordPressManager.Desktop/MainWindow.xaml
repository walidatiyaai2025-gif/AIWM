       <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Content="Open logs folder" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Logs.OpenFolderCommand}"/>
        <Button Content="Test WordPress connection" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Sites" Margin="10,0,0,0" ToolTip="Open the active site settings and run Test connection. Return here and press Refresh to see the logged REST response."/>
        <Button Content="Refresh" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" Command="{Binding Logs.LoadCommand}"/>
       </StackPanel>
      </Grid>
      <UniformGrid Columns="4" Margin="0,24,0,18">
       <Button Style="{StaticResource NavigationCardButtonStyle}" Margin="0,0,10,0" Command="{Binding Logs.OpenFolderCommand}" ToolTip="Open the local logs folder"><StackPanel><TextBlock Text="LOG FILES" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding Logs.FileCount}" FontSize="26" FontWeight="Bold"/></StackPanel></Button>
       <Button Style="{StaticResource NavigationCardButtonStyle}" Margin="0,0,10,0" Command="{Binding Logs.LoadCommand}" ToolTip="Refresh WordPress API responses"><StackPanel><TextBlock Text="WORDPRESS REQUESTS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding Logs.ApiRequestCount}" FontSize="26" FontWeight="Bold"/></StackPanel></Button>
       <Button Style="{StaticResource NavigationCardButtonStyle}" Margin="0,0,10,0" Command="{Binding Logs.LoadCommand}" ToolTip="Refresh successful WordPress responses"><StackPanel><TextBlock Text="SUCCESS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding Logs.ApiSuccessCount}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/></StackPanel></Button>
       <Button Style="{StaticResource NavigationCardButtonStyle}" Command="{Binding Logs.LoadCommand}" ToolTip="Refresh failed WordPress responses"><StackPanel><TextBlock Text="FAILED" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding Logs.ApiFailureCount}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/></StackPanel></Button>
      </UniformGrid>
      <TabControl>
       <TabItem Header="WordPress API responses">
