      <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="SITE POLICY" FontSize="18" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Orchestrator.Modes}" SelectedItem="{Binding Orchestrator.SelectedMode}" Margin="0,10,0,10"/><CheckBox Content="Allow meta changes" IsChecked="{Binding Orchestrator.AllowMetaChanges}"/><CheckBox Content="Allow content changes" IsChecked="{Binding Orchestrator.AllowContentChanges}" Margin="0,6,0,0"/><CheckBox Content="Allow Visual CSS through verified Bridge" IsChecked="{Binding Orchestrator.AllowVisualCss}" Margin="0,6,0,0"/><CheckBox Content="Require approval for titles and H1" IsChecked="{Binding Orchestrator.RequireApprovalForTitles}" Margin="0,6,0,0"/><CheckBox Content="Never publish automatically" IsChecked="{Binding Orchestrator.NeverPublishAutomatically}" Margin="0,6,0,0"/></StackPanel></Border>
     </Grid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Workflow pipeline" FontSize="20" FontWeight="SemiBold"/><UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,14"><Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="0,0,6,0"><StackPanel><TextBlock Text="ISSUES" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding Orchestrator.DetectedIssues}" FontSize="24" FontWeight="Bold"/></StackPanel></Border><Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="3,0"><StackPanel><TextBlock Text="AI ACTIONS" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding Orchestrator.GeneratedActions}" FontSize="24" FontWeight="Bold"/></StackPanel></Border><Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="3,0"><StackPanel><TextBlock Text="READY" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding Orchestrator.ReadyActions}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/></StackPanel></Border><Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="6,0,0,0"><StackPanel><TextBlock Text="FAILED JOBS" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding Orchestrator.FailedJobs}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/></StackPanel></Border></UniformGrid>
       <DataGrid Grid.Row="2" ItemsSource="{Binding Orchestrator.Stages}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Stage" Binding="{Binding Name}" Width="130"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="What happens" Binding="{Binding Detail}" Width="*"/><DataGridTextColumn Header="Completed" Binding="{Binding CompletedAt, StringFormat={}{0:HH:mm:ss}}" Width="100"/></DataGrid.Columns></DataGrid></Grid></Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Live orchestration timeline" FontSize="20" FontWeight="SemiBold"/><ListBox Grid.Row="1" ItemsSource="{Binding Orchestrator.Timeline}" Margin="0,14,0,14" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Foreground="{DynamicResource TextSecondaryBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="Open Execution Center" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Orchestrator.OpenExecutionCommand}" HorizontalAlignment="Left"/></Grid></Border>
     </Grid>
    </Grid>

    <ScrollViewer Visibility="{Binding IsSiteBrainVisible, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="30">
      <Grid><StackPanel><TextBlock Text="AI Site Brain" FontSize="30" FontWeight="Bold"/><TextBlock Text="Persistent, site-specific memory for language, brand, SEO, content, and design decisions." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="↻  Reload" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SiteBrain.LoadCommand}"/><Button Content="✓  Save memory" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" Command="{Binding SiteBrain.SaveCommand}"/></StackPanel></Grid>
