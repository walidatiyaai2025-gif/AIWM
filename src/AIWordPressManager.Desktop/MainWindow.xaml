     </Grid>
     <UniformGrid Grid.Row="1" Columns="5" Margin="0,18,0,18">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,4,0"><StackPanel><TextBlock Text="TOTAL" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding TransactionCenter.TotalCount}" FontSize="27" FontWeight="Bold"/><TextBlock Text="Journaled transactions" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="4,0"><StackPanel><TextBlock Text="COMMITTED" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding TransactionCenter.CommittedCount}" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Text="Verified terminal state" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
