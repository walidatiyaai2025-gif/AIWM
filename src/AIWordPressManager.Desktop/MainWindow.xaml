        <TextBlock Text="{Binding Sites.SelectedSiteDetails.SiteUrl}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <Separator Margin="0,18" Background="{DynamicResource BorderBrush}"/>
        <UniformGrid Columns="2" Margin="0,0,0,16"><StackPanel Margin="0,0,10,12"><TextBlock Text="WordPress user" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding Sites.SelectedSiteDetails.UserName}" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="10,0,0,12"><TextBlock Text="Last tested" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding Sites.SelectedLastTestText}" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="0,0,10,12"><TextBlock Text="WordPress version" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding Sites.SelectedSiteDetails.WordPressVersion, TargetNullValue=Not returned}" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="10,0,0,12"><TextBlock Text="Language" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding Sites.SelectedSiteDetails.LanguageCode, TargetNullValue=Not returned}" Margin="0,4,0,0"/></StackPanel></UniformGrid>
        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock Text="Local-first management" FontWeight="SemiBold"/><TextBlock Text="All modules load this site's latest SQLite snapshot first. Live WordPress requests run only when you explicitly start them." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
        <Button Content="Open WordPress Explorer" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="WordPress Explorer"/>
        <UniformGrid Columns="2" Margin="0,10,0,0"><Button Content="Open website" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0" Command="{Binding Sites.OpenSelectedSiteCommand}"/><Button Content="Open wp-admin" Style="{StaticResource SecondaryButtonStyle}" Margin="5,0,0,0" Command="{Binding Sites.OpenWordPressAdminCommand}"/></UniformGrid>
        <UniformGrid Columns="2" Margin="0,10,0,0"><Button Content="Copy URL" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0" Command="{Binding Sites.CopySelectedUrlCommand}"/><Button Content="Retest connection" Style="{StaticResource SecondaryButtonStyle}" Margin="5,0,0,0" Command="{Binding Sites.RetestSelectedSiteCommand}"/></UniformGrid>
        <Button Content="Remove from application" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" Foreground="{DynamicResource DangerBrush}" Command="{Binding Sites.DeleteSelectedSiteCommand}"/>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>

     <Border Grid.Row="4" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12,8" Margin="0,14,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Sites.StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding Sites.ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Sites.ResultsSummary}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0"/><TextBlock Text="{Binding Sites.CurrentOperation}" Foreground="{DynamicResource PrimaryHoverBrush}"/></StackPanel></Grid>
     </Border>
    </Grid>
    <Grid Visibility="{Binding IsExplorerVisible, Converter={StaticResource BoolToVisibility}}" Margin="30">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <StackPanel><TextBlock Text="WordPress Explorer" FontSize="30" FontWeight="Bold"/><TextBlock Text="Browse the latest SQLite snapshot, filter every content type, preview details, and synchronize only when requested." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,22"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Command="{Binding Explorer.CancelCommand}"/><Button Content="Synchronize now" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Explorer.RefreshCommand}"/></StackPanel>
     </Grid>
     <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="{Binding Explorer.SelectedSiteName}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Explorer.StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/><ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding Explorer.ProgressPercent}" Margin="0,12,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="24,0,0,0"><TextBlock Text="{Binding Explorer.LoadedAt, StringFormat='Loaded {0:g}', TargetNullValue=Not loaded}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Explorer.CurrentOperation}" Margin="0,7,0,0" HorizontalAlignment="Right"/><TextBlock Text="{Binding Explorer.LastSyncSummary}" Foreground="{DynamicResource PrimaryHoverBrush}" Margin="0,7,0,0" HorizontalAlignment="Right"/></StackPanel>
      </Grid>
     </Border>
     <UniformGrid Grid.Row="2" Columns="5" Margin="0,0,0,14">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Posts"/><TextBlock Text="{Binding Explorer.TotalPosts}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Explorer.FilteredPostsCount, StringFormat='Visible: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="3,0"><StackPanel><TextBlock Text="Pages"/><TextBlock Text="{Binding Explorer.TotalPages}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Explorer.FilteredPagesCount, StringFormat='Visible: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="3,0"><StackPanel><TextBlock Text="Categories"/><TextBlock Text="{Binding Explorer.TotalCategories}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Explorer.FilteredCategoriesCount, StringFormat='Visible: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="3,0"><StackPanel><TextBlock Text="Tags"/><TextBlock Text="{Binding Explorer.TotalTags}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Explorer.FilteredTagsCount, StringFormat='Visible: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Media"/><TextBlock Text="{Binding Explorer.TotalMedia}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Explorer.FilteredMediaCount, StringFormat='Visible: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
     </UniformGrid>
     <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Explorer.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search title, slug, MIME type or WordPress ID"/><ComboBox Grid.Column="1" ItemsSource="{Binding Explorer.StatusOptions}" SelectedItem="{Binding Explorer.SelectedStatus}" Margin="12,0,0,0"/><Button Grid.Column="2" Content="Clear filters" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" Command="{Binding Explorer.ClearFiltersCommand}"/></Grid>
     </Border>
     <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
      <TabControl>
       <TabItem Header="Posts">
        <DataGrid ItemsSource="{Binding Explorer.Posts}" SelectedItem="{Binding Explorer.SelectedContent}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="3*"/><DataGridTextColumn Header="Slug" Binding="{Binding Slug}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt}" Width="150"/></DataGrid.Columns></DataGrid>
       </TabItem>
       <TabItem Header="Pages">
        <DataGrid ItemsSource="{Binding Explorer.Pages}" SelectedItem="{Binding Explorer.SelectedContent}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="3*"/><DataGridTextColumn Header="Slug" Binding="{Binding Slug}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt}" Width="150"/></DataGrid.Columns></DataGrid>
       </TabItem>
       <TabItem Header="Categories"><DataGrid ItemsSource="{Binding Explorer.Categories}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Slug" Binding="{Binding Slug}" Width="2*"/><DataGridTextColumn Header="Posts" Binding="{Binding Count}" Width="80"/></DataGrid.Columns></DataGrid></TabItem>
       <TabItem Header="Tags"><DataGrid ItemsSource="{Binding Explorer.Tags}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Slug" Binding="{Binding Slug}" Width="2*"/><DataGridTextColumn Header="Posts" Binding="{Binding Count}" Width="80"/></DataGrid.Columns></DataGrid></TabItem>
       <TabItem Header="Media"><DataGrid ItemsSource="{Binding Explorer.Media}" SelectedItem="{Binding Explorer.SelectedMedia}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Type" Binding="{Binding MimeType}" Width="*"/><DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt}" Width="150"/></DataGrid.Columns></DataGrid></TabItem>
      </TabControl>
      <Grid Grid.Column="1" Margin="14,0,0,0"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8"><ScrollViewer><StackPanel>
        <TextBlock Text="Selected content" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Explorer.SelectedContent.Title, TargetNullValue=Select a post or page}" FontSize="20" FontWeight="Bold" Margin="0,14,0,4" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Explorer.SelectedContent.Link}" Foreground="{DynamicResource PrimaryHoverBrush}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Explorer.SelectedContent.ModifiedAt, StringFormat='Modified: {0:g}'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,14"/>
        <TextBlock Text="{Binding Explorer.SelectedContentSummary}" TextWrapping="Wrap" MaxHeight="280"/>
        <UniformGrid Columns="2" Margin="0,16,0,0"><Button Content="Open page" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,5,0" Command="{Binding Explorer.OpenSelectedContentCommand}"/><Button Content="Copy link" Style="{StaticResource SecondaryButtonStyle}" Margin="5,0,0,0" Command="{Binding Explorer.CopySelectedContentLinkCommand}"/></UniformGrid>
        <Separator Margin="0,18" Background="{DynamicResource BorderBrush}"/>
        <TextBlock Text="Selected media" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Explorer.SelectedMedia.Title, TargetNullValue=Select a media item}" Margin="0,8,0,3" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Explorer.SelectedMedia.SourceUrl}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        <UniformGrid Columns="2" Margin="0,12,0,0"><Button Content="Open media" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,5,0" Command="{Binding Explorer.OpenSelectedMediaCommand}"/><Button Content="Copy URL" Style="{StaticResource SecondaryButtonStyle}" Margin="5,0,0,0" Command="{Binding Explorer.CopySelectedMediaUrlCommand}"/></UniformGrid>
       </StackPanel></ScrollViewer></Border>
       <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,8,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Recent activity" FontSize="18" FontWeight="SemiBold"/><ListBox Grid.Row="1" ItemsSource="{Binding Explorer.Activity}" Margin="0,12,0,0" Background="Transparent" BorderThickness="0"/></Grid></Border>
      </Grid>
     </Grid>
    </Grid>
    <Grid Visibility="{Binding IsContentAuditVisible, Converter={StaticResource BoolToVisibility}}" Margin="30">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid>
        <StackPanel>
          <TextBlock Text="Content Audit" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="Review measurable content quality signals from the latest local WordPress snapshot."
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,22"/>
        </StackPanel>
        <Button Content="Run audit" Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Command="{Binding ContentAudit.RunAuditCommand}"/>
      </Grid>

      <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,18">
        <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Score"/><TextBlock Text="{Binding ContentAudit.Score}" FontSize="28" FontWeight="Bold"/><TextBlock Text="out of 100" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}" Margin="3,0"><StackPanel><TextBlock Text="Audited"/><TextBlock Text="{Binding ContentAudit.AuditedItems}" FontSize="28" FontWeight="Bold"/><TextBlock Text="posts and pages" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}" Margin="3,0"><StackPanel><TextBlock Text="High"/><TextBlock Text="{Binding ContentAudit.HighIssues}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/><TextBlock Text="priority issues" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}" Margin="3,0"><StackPanel><TextBlock Text="Medium"/><TextBlock Text="{Binding ContentAudit.MediumIssues}" FontSize="28" FontWeight="Bold"/><TextBlock Text="review issues" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}" Margin="3,0"><StackPanel><TextBlock Text="Low"/><TextBlock Text="{Binding ContentAudit.LowIssues}" FontSize="28" FontWeight="Bold"/><TextBlock Text="minor issues" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Visible"/><TextBlock Text="{Binding ContentAudit.VisibleIssues}" FontSize="28" FontWeight="Bold"/><TextBlock Text="after filters" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
      </UniformGrid>

      <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Search audit results" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding ContentAudit.SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" Padding="9,6" ToolTip="Search title, issue code, description, type, severity, or WordPress ID"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="Severity" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding ContentAudit.SeverityOptions}" SelectedItem="{Binding ContentAudit.SelectedSeverity}" MinHeight="34"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,12,0">
            <TextBlock Text="Content type" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding ContentAudit.TypeOptions}" SelectedItem="{Binding ContentAudit.SelectedType}" MinHeight="34"/>
          </StackPanel>
          <Button Grid.Column="3" Content="Clear filters" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ContentAudit.ClearFiltersCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
          <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="Last completed" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding ContentAudit.LastCompleted}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,7,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding ContentAudit.StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding ContentAudit.IssuesView}" SelectedItem="{Binding ContentAudit.SelectedIssue}"
                      AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="160"/>
                <DataGridTextColumn Header="Type" Binding="{Binding ContentType}" Width="85"/>
                <DataGridTextColumn Header="WP ID" Binding="{Binding WordPressId}" Width="75"/>
                <DataGridTextColumn Header="Content" Binding="{Binding ContentTitle}" Width="2*"/>
                <DataGridTextColumn Header="Issue" Binding="{Binding Description}" Width="3*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="7,0,0,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Issue preview" FontSize="18" FontWeight="Bold"/>
            <TextBlock Grid.Row="1" Text="{Binding ContentAudit.SelectedIssueTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,8"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="{Binding ContentAudit.SelectedIssueDetails}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="Page link" FontWeight="SemiBold" Margin="0,18,0,5"/>
                <TextBlock Text="{Binding ContentAudit.SelectedIssueLink}" TextWrapping="Wrap" Foreground="{DynamicResource GoldOnLightBrush}"/>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button Content="Copy link" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ContentAudit.CopyLinkCommand}" Margin="0,0,8,0"/>
              <Button Content="Open page" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ContentAudit.OpenSelectedCommand}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid Visibility="{Binding IsSeoAuditVisible, Converter={StaticResource BoolToVisibility}}" Margin="30">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><StackPanel><TextBlock Text="SEO Audit" FontSize="30" FontWeight="Bold"/><TextBlock Text="Measurable SEO checks loaded from SQLite first, with explicit live execution only when requested." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,22" TextWrapping="Wrap"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Open selected page" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SeoAudit.OpenSelectedCommand}"/><Button Content="Run SEO audit" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" Command="{Binding SeoAudit.RunAuditCommand}"/></StackPanel></Grid>
     <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,18"><Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="SEO Score"/><TextBlock Text="{Binding SeoAudit.Score}" FontSize="28" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="4,0"><StackPanel><TextBlock Text="Audited"/><TextBlock Text="{Binding SeoAudit.AuditedItems}" FontSize="28" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="4,0"><StackPanel><TextBlock Text="High"/><TextBlock Text="{Binding SeoAudit.HighIssues}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="4,0"><StackPanel><TextBlock Text="Medium"/><TextBlock Text="{Binding SeoAudit.MediumIssues}" FontSize="28" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Low"/><TextBlock Text="{Binding SeoAudit.LowIssues}" FontSize="28" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
     <TabControl Grid.Row="2">
      <TabItem Header="Current findings">
       <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding SeoAudit.StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}"/><DataGrid Grid.Row="1" ItemsSource="{Binding SeoAudit.Issues}" SelectedItem="{Binding SeoAudit.SelectedIssue}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0"><DataGrid.Columns><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="170"/><DataGridTextColumn Header="Content" Binding="{Binding ContentTitle}" Width="2*"/><DataGridTextColumn Header="Finding" Binding="{Binding Description}" Width="3*"/></DataGrid.Columns></DataGrid></Grid></Border>
        <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Selected SEO finding" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SeoAudit.SelectedIssue.ContentTitle, TargetNullValue=Select a row to inspect it}" FontSize="16" FontWeight="Bold" Margin="0,16,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding SeoAudit.SelectedIssue.Code}" Foreground="{DynamicResource PrimaryHoverBrush}" Margin="0,8,0,0"/><TextBlock Text="{Binding SeoAudit.SelectedIssue.Description}" Margin="0,16,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding SeoAudit.SelectedIssue.Link}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/><Button Content="Copy link" Style="{StaticResource SecondaryButtonStyle}" Margin="0,18,0,0" HorizontalAlignment="Left" Command="{Binding SeoAudit.CopySelectedLinkCommand}"/></StackPanel></Border>
       </Grid>
