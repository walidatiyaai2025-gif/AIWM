          <DataGridTemplateColumn Header="Progress" Width="1.2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="4"><ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="14"/><TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
