     <Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Post &amp; Page SEO Editor" FontSize="24" FontWeight="Bold"/><TextBlock Text="Offline list loads first. Selecting a row now loads its live editable fields automatically." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/><Button Content="Reload offline list" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PostEditor.LoadOfflineCommand}"/><TextBlock Text="Ctrl/Shift-click to select multiple items for bulk editing." Foreground="{DynamicResource PrimaryHoverBrush}" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding PostEditor.SelectedCount, StringFormat=Selected: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding PostEditor.Items}" SelectedItem="{Binding PostEditor.SelectedItem}" b:DataGridSelectedItemsBehavior.SelectedItems="{Binding PostEditor.SelectedItems, Mode=OneWay}" SelectionMode="Extended" AutoGenerateColumns="False" Margin="0,14,0,0"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding ContentType}" Width="60"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75"/></DataGrid.Columns></DataGrid></Grid></Border>
