dOnly="True" Height="180" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding WordPressId}" Width="60"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="References" Binding="{Binding ReferenceCount}" Width="85"/><DataGridCheckBoxColumn Header="Exclusive" Binding="{Binding SafeToDeleteWithSelectedContent}" Width="80"/></DataGrid.Columns></DataGrid></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Content operations" FontSize="17" FontWeight="SemiBold"/><WrapPanel Margin="0,12,0,0"><Button Content="Move to Trash" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DeletionCenter.MoveToTrashCommand}"/><Button Content="Trash + delete exclusive media" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Command="{Binding DeletionCenter.DeleteContentWithMediaCommand}"/><Button Content="Permanent delete" Style="{StaticResource SecondaryButtonStyle}" Foreground="{DynamicResource DangerBrush}" Margin="8,0,0,0" Command="{Binding DeletionCenter.DeleteContentPermanentlyCommand}"/></WrapPanel><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><TextBlock Text="Restore status" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding DeletionCenter.RestoreStatuses}" SelectedItem="{Binding DeletionCenter.RestoreStatus}" Width="120" Margin="10,0"/><Button Content="Restore from Trash" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeletionCenter.RestoreCommand}"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></Grid></TabItem>
